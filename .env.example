PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_NAME=local_food_db
DB_USER=root
DB_PASSWORD=sua_senha
DB_LOGGING=false

# No Render, conecte um Postgres e use a Internal Database URL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DB_SSL=false

JWT_SECRET=sua_chave_secreta
JWT_EXPIRES_IN=1d
ADMIN_INVITE_CODE=LOCALFOOD2026

UPLOAD_PATH=uploads

# Envio real de e-mail para codigo de verificacao.
# Exemplo Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_de_app
# MAIL_FROM="LocalFood <seu_email@gmail.com>"
# MAIL_APP_NAME=LocalFood
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_APP_NAME=LocalFood

# Recomendado no plano gratuito do Render, que bloqueia portas SMTP.
# Cadastre e confirme BREVO_FROM_EMAIL como remetente no painel do Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=seu_email@gmail.com
BREVO_FROM_NAME=TimeOut

# Envio de código por telefone usando Twilio.
# Para SMS, use um número Twilio no formato +5511999999999.
# Para WhatsApp, use o número/sandbox habilitado no formato +14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# Pagamentos reais com Mercado Pago.
# O access token deve ficar apenas no backend. Nunca coloque essa chave no frontend.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=http://localhost:3001/api/v1/payments/webhooks/mercado-pago
CHECKOUT_SUCCESS_URL=http://localhost:5173/
CHECKOUT_PENDING_URL=http://localhost:5173/
CHECKOUT_FAILURE_URL=http://localhost:5173/
